# PRiSM Configuration
# Copy this file to .env. Ready to use with the bundled htx_example dataset.
# =============================================================================

# =============================================================================
# Dataset and config selection
# =============================================================================

# Full config mode (loads example_notebooks/config/{name}.yaml)
# The htx_example config is pre-configured for the included heart transplant dataset
PRISM_CONFIG=htx_example

# Alternative: quick mode, which takes just a dataset name and uses notebook defaults
# Uncomment below and comment out PRISM_CONFIG above to use quick mode
# PRISM_DATASET=my_data

# If both are set, PRISM_CONFIG takes precedence

# =============================================================================
# Optional: override output and data directories
# =============================================================================
# These are useful for parallel execution or custom directory layouts

# PRISM_MODELS_DIR=
# PRISM_INTERIM_DATA_DIR=
# PRISM_PROCESSED_DATA_DIR=

# Relocates the data/ and models/ directories the library reads and writes,
# for a pip install working on your own data. It does not replace a clone: the
# prism CLI finds configs and notebooks under example_notebooks/ in the current
# working directory and ignores this setting.
# PRISM_PROJECT_DIR=

# =============================================================================
# Optional: compute device
# =============================================================================
# Priority: a config's `device:` key wins, then PRISM_DEVICE, then auto-detect
# (CUDA, then MPS, then CPU). One of: auto, cpu, cuda, cuda:N, mps.

# PRISM_DEVICE=
